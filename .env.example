# Copy to .env for local development. Never commit real secrets.
PORT=10000
NODE_ENV=development
DATABASE_URL=postgresql://localhost:5432/reto
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
FRONTEND_ORIGIN=http://localhost:10000
# Optional: set true only when DATABASE_URL uses a hosted TLS database.
DATABASE_SSL=false
